#!/bin/sh
# Menu action: change one setting, then collect so the menu reflects it right away.
# Invalid input (e.g. a clipboard that is not an address) is reported as a notification.
. "$HOME/Library/Application Support/xan-watch/env.sh"
REPO=$(cd "$(dirname "$0")/.." && pwd)
key=$1
value=$2
[ "$value" = clipboard ] && value=$(pbpaste)
notify() {
  osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "xan-watch"' -e 'end run' "$1"
}
if ! err=$("$BUN" "$REPO/src/config.ts" --set "$key" "$value" 2>&1); then
  notify "$err"
  exit 1
fi
case "$key" in
  address)
    if [ "$value" = none ]; then notify "Address removed"; else notify "Address set to $value, reading balances"; fi
    "$(dirname "$0")/collect-once" ;;
  reset)
    notify "Settings reset to defaults"
    "$(dirname "$0")/collect-once" ;;
esac
